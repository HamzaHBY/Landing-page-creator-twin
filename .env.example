# OpenAI API key on an org verified for gpt-image-1.
# Used by the "Ultimate" quality tier (Twin Studio's `sketch_model: "gpt-image-2"`).
OPENAI_API_KEY=sk-...

# Optional — fal.ai API key. Used by the "Premium" quality tier (Recraft V3 via
# fal-ai/recraft-v3) and as a fallback if you'd rather route gpt-image-1 through
# fal-ai/gpt-image-1/edit-image instead of OpenAI direct.
FAL_KEY=
